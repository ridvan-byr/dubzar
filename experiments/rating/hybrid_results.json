 "mapping": [
  {
   "id": 3,
   "category": "konusma",
   "context": "",
   "en": "We've got about five minutes before they notice.",
   "tr": "Fark edeceklerinden önce yaklaşık beş dakikaımız var."
  },
  {
   "id": 8,
   "category": "konusma",
   "context": "",
   "en": "That doesn't sound like him at all.",
   "tr": "Bu, onun sesi gibi değil."
  },
  {
   "id": 11,
   "category": "konusma",
   "context": "",
   "en": "I thought we agreed to meet at noon.",
   "tr": "Öğlen saatinde buluşmakta anlaştığımızı sanıyordum."
  },
  {
   "id": 17,
   "category": "konusma",
   "context": "",
   "en": "Nobody has been in this room for years.",
   "tr": "Yıllardır kimse bu odada bulunmamıştır."
  },
  {
   "id": 25,
   "category": "konusma",
   "context": "",
   "en": "You can't just walk away from this.",
   "tr": "Bundan sadece uzaklaşamazsınız."
  },
  {
   "id": 32,
   "category": "konusma",
   "context": "",
   "en": "We're running low on supplies.",
   "tr": "Malzeme stoklarımız azalıyor."
  },
  {
   "id": 34,
   "category": "konusma",
   "context": "",
   "en": "Is that really the best you can do?",
   "tr": "Bu gerçekten yapabileceğiniz en iyisi mi?"
  },
  {
   "id": 36,
   "category": "argo",
   "context": "",
   "en": "Stop acting like a clown and listen up.",
   "tr": "Palyaço gibi davranmayı bırakın ve dinleyin."
  },
  {
   "id": 37,
   "category": "argo",
   "context": "",
   "en": "That dude's got a screw loose.",
   "tr": "O adamın bir sorunu var."
  },
  {
   "id": 38,
   "category": "argo",
   "context": "",
   "en": "I'm gonna wipe that smirk right off your face.",
   "tr": "Yüzündeki o gülümsemeyi silip atacağım."
  },
  {
   "id": 39,
   "category": "argo",
   "context": "",
   "en": "She's been giving me the cold shoulder all week.",
   "tr": "Tüm hafta boyunca bana soğuk davranıyor."
  },
  {
   "id": 40,
   "category": "argo",
   "context": "",
   "en": "Get off my back, will you?",
   "tr": "Sırtımı yormayın, olur mu?"
  },
  {
   "id": 41,
   "category": "argo",
   "context": "",
   "en": "You're full of it, and you know it.",
   "tr": "Bundan dolayısın ve bunu biliyorsun."
  },
  {
   "id": 42,
   "category": "argo",
   "context": "",
   "en": "He's all talk and no action.",
   "tr": "Sadece konuşuyor, hiçbir eylemde bulunmuyor."
  },
  {
   "id": 43,
   "category": "argo",
   "context": "",
   "en": "Don't try to sweet-talk me.",
   "tr": "Bana tatlı sözler söylemeye çalışma."
  },
  {
   "id": 44,
   "category": "argo",
   "context": "",
   "en": "We got played, man. Big time.",
   "tr": "Yenildik, dostum. Çok büyük bir yenilgi."
  },
  {
   "id": 45,
   "category": "argo",
   "context": "",
   "en": "That guy is a snake in the grass.",
   "tr": "O adam, otların arasındaki bir yılan."
  },
  {
   "id": 47,
   "category": "argo",
   "context": "",
   "en": "Hand over the cash or things get ugly.",
   "tr": "Nakit parayı verin, yoksa durum kötüleşir."
  },
  {
   "id": 48,
   "category": "argo",
   "context": "",
   "en": "She's out of her league and she knows it.",
   "tr": "O, onun seviyesinin dışında ve bunu biliyor."
  },
  {
   "id": 49,
   "category": "argo",
   "context": "",
   "en": "What a bunch of lowlifes.",
   "tr": "Ne kadar kötü insanlar."
  },
  {
   "id": 51,
   "category": "argo",
   "context": "",
   "en": "Man, this place gives me the creeps.",
   "tr": "Aman, bu yer beni ürkütüyor."
