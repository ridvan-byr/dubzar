 "mapping": [
  {
   "id": 2,
   "category": "konusma",
   "context": "",
   "en": "Where were you when the lights went out?",
   "tr": "Işıklar sönünce neredeydin?"
  },
  {
   "id": 8,
   "category": "konusma",
   "context": "",
   "en": "That doesn't sound like him at all.",
   "tr": "Bu hiç de onun gibi gelmiyor."
  },
  {
   "id": 10,
   "category": "konusma",
   "context": "",
   "en": "You'd better have a good explanation.",
   "tr": "İyi bir açıklaman olsa iyi olur."
  },
  {
   "id": 14,
   "category": "konusma",
   "context": "",
   "en": "Why does everyone keep looking at me like that?",
   "tr": "Neden herkes bana sürekli böyle bakıyor?"
  },
  {
   "id": 16,
   "category": "konusma",
   "context": "",
   "en": "You're lucky I'm in a good mood today.",
   "tr": "Bugün havamda olduğum için şanslısın."
  },
  {
   "id": 17,
   "category": "konusma",
   "context": "",
   "en": "Nobody has been in this room for years.",
   "tr": "Bu odaya yıllardır kimse girmedi."
  },
  {
   "id": 18,
   "category": "konusma",
   "context": "",
   "en": "Let me handle the talking.",
   "tr": "Konuşmayı bana bırak."
  },
  {
   "id": 22,
   "category": "konusma",
   "context": "",
   "en": "I wish things had turned out differently.",
   "tr": "Keşke işler farklı olsaydı."
  },
  {
   "id": 23,
   "category": "konusma",
   "context": "",
   "en": "Do you really expect me to believe that?",
   "tr": "Buna gerçekten inanmamı mı bekliyorsun?"
  },
  {
   "id": 25,
   "category": "konusma",
   "context": "",
   "en": "You can't just walk away from this.",
   "tr": "Bundan öylece kurtulamazsın."
  },
  {
   "id": 30,
   "category": "konusma",
   "context": "",
   "en": "He left a note on the kitchen table.",
   "tr": "Mutfak masasında bir not bıraktı."
  },
  {
   "id": 32,
   "category": "konusma",
   "context": "",
   "en": "We're running low on supplies.",
   "tr": "Yeterli erzağımız azalıyor."
  },
  {
   "id": 34,
   "category": "konusma",
   "context": "",
   "en": "Is that really the best you can do?",
   "tr": "Gerçekten yapabileceğin en iyi şey bu mu?"
  },
  {
   "id": 36,
   "category": "argo",
   "context": "",
   "en": "Stop acting like a clown and listen up.",
   "tr": "Palyaço gibi davranmayı bırak da dinle."
  },
  {
   "id": 39,
   "category": "argo",
   "context": "",
   "en": "She's been giving me the cold shoulder all week.",
   "tr": "Bütün hafta bana soğuk davranıp durdu."
  },
  {
   "id": 40,
   "category": "argo",
   "context": "",
   "en": "Get off my back, will you?",
   "tr": "Arkamdan çekil, olur mu?"
  },
  {
   "id": 41,
   "category": "argo",
   "context": "",
   "en": "You're full of it, and you know it.",
   "tr": "Palavra atıyorsun ve bunu biliyorsun."
  },
  {
   "id": 42,
   "category": "argo",
   "context": "",
   "en": "He's all talk and no action.",
   "tr": "Hep konuşur ama hareket etmez."
  },
  {
   "id": 43,
   "category": "argo",
   "context": "",
   "en": "Don't try to sweet-talk me.",
   "tr": "Benimle tatlı konuşmaya çalışma."
  },
  {
   "id": 45,
   "category": "argo",
   "context": "",
   "en": "That guy is a snake in the grass.",
   "tr": "O herif çimlerin arasında bir yılan."
  },
  {
   "id": 47,
   "category": "argo",
   "context": "",
   "en": "Hand over the cash or things get ugly.",
   "tr": "Parayı teslim et, yoksa işler çirkinleşir."
  },
  {
   "id": 48,
   "category": "argo",
   "context": "",
   "en": "She's out of her league and she knows it.",
   "tr": "O kendine ait değil ve bunu biliyor."
  },
  {
   "id": 50,
   "category": "argo",
   "context": "",
   "en": "You think I was born yesterday?",
   "tr": "Sence dün mü doğdum?"
  },
  {
   "id": 51,
   "category": "argo",
   "context": "",
   "en": "Man, this place gives me the creeps.",
   "tr": "Dostum, burası beni ürpertiyor."
  },
  {
   "id": 53,
   "category": "argo",
   "context": "",
   "en": "Nice try, hotshot.",
   "tr": "İyi deneme, şapşal."
  },
  {
   "id": 54,
   "category": "argo",
   "context": "",
   "en": "I'll be damned if I let you take the credit.",
   "tr": "Krediyi almana izin verirsem lanetlenirim."
  },
  {
   "id": 55,
   "category": "argo",
   "context": "",
   "en": "That's a load of garbage and you know it.",
   "tr": "Bu çok fazla çöp ve sen de biliyorsun."
  },
  {
   "id": 56,
   "category": "argo",
   "context": "",
   "en": "Don't you dare flake on me again.",
   "tr": "Sakın bir daha beni kazıklamaya kalkma."
  },
  {
   "id": 57,
   "category": "argo",
   "context": "",
   "en": "He's been dodging me like the plague.",
   "tr": "Beni veba gibi atlatıyor."
  },
  {
   "id": 58,
   "category": "argo",
   "context": "",
   "en": "This whole thing stinks.",
   "tr": "Bütün bu iş berbat."
  },
  {
   "id": 61,
   "category": "argo",
   "context": "",
   "en": "She dumped him on the spot.",
   "tr": "Onu yerinde terk etti."
  },
  {
   "id": 62,
   "category": "argo",
   "context": "",
   "en": "Quit your whining and move it.",
   "tr": "Sızlanmayı bırak da hareket et."
  },
  {
   "id": 63,
   "category": "argo",
   "context": "",
   "en": "They were wasted before noon.",
   "tr": "Öğleden önce sarhoştular."
  },
  {
   "id": 64,
   "category": "argo",
   "context": "",
   "en": "Talk about bad luck, huh?",
   "tr": "Kötü şanstan söz et, ha?"
  },
  {
   "id": 65,
   "category": "argo",
   "context": "",
   "en": "That's a rip-off and you know it.",
   "tr": "Bu bir kazık ve sen de bunu biliyorsun."
  },
  {
   "id": 66,
   "category": "argo",
   "context": "",
   "en": "Back off, or I swear I'll lose it.",
   "tr": "Geri çekil, yoksa yemin ederim kaybedeceğim."
  },
  {
   "id": 67,
   "category": "argo",
   "context": "",
   "en": "You're a total pushover.",
   "tr": "Tam bir iticisin."
  },
  {
   "id": 68,
   "category": "argo",
   "context": "",
   "en": "The cops were all over us.",
   "tr": "Polis her yanımızı sarmıştı."
  },
  {
   "id": 69,
   "category": "argo",
   "context": "",
   "en": "Take a hike, pal.",
   "tr": "Hadi git, dostum."
  },
  {
   "id": 70,
   "category": "argo",
   "context": "",
   "en": "He's loaded, but he's cheap as hell.",
   "tr": "Parası var ama çok ucuz."
  },
  {
   "id": 71,
   "category": "argo",
   "context": "",
   "en": "Spill it, or I'll make you.",
   "tr": "Söyle, yoksa seni döverim."
  },
  {
   "id": 72,
   "category": "argo",
   "context": "",
   "en": "Man, you're a lifesaver.",
