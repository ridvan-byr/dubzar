 "mapping": [
  {
   "id": 3,
   "category": "konusma",
   "context": "",
   "en": "We've got about five minutes before they notice.",
   "tr": "Fark etmeden önce beş dakikamız var."
  },
  {
   "id": 6,
   "category": "konusma",
   "context": "",
   "en": "Whatever happens, stay close to me.",
   "tr": "Ne olursa olsun bana yakın dur."
  },
  {
   "id": 8,
   "category": "konusma",
   "context": "",
   "en": "That doesn't sound like him at all.",
   "tr": "Bu hiç de onun yapacağı bir şey değil."
  },
  {
   "id": 11,
   "category": "konusma",
   "context": "",
   "en": "I thought we agreed to meet at noon.",
   "tr": "Öğlen buluşmaya karar verdiğimizi sanıyordum."
  },
  {
   "id": 13,
   "category": "konusma",
   "context": "",
   "en": "I don't have time for riddles.",
   "tr": "Bilmecelere ayıracak vaktim yok."
  },
  {
   "id": 17,
   "category": "konusma",
   "context": "",
   "en": "Nobody has been in this room for years.",
   "tr": "Yıllardır bu odaya kimse girmedi."
  },
  {
   "id": 27,
   "category": "konusma",
   "context": "",
   "en": "Was there anyone with you?",
   "tr": "Yanında biri var mıydı?"
  },
  {
   "id": 31,
   "category": "konusma",
   "context": "",
   "en": "You look like you've seen a ghost.",
   "tr": "Bir hayalet görmüş gibi görünüyorsun."
  },
  {
   "id": 33,
   "category": "konusma",
   "context": "",
   "en": "I told them everything I knew.",
   "tr": "Onlara bildiğim her şeyi söyledim."
  },
  {
   "id": 34,
   "category": "konusma",
   "context": "",
   "en": "Is that really the best you can do?",
   "tr": "Elinden gelenin en iyisi bu mu gerçekten?"
  },
  {
   "id": 37,
   "category": "argo",
   "context": "",
   "en": "That dude's got a screw loose.",
   "tr": "O herifin işi bitti."
  },
  {
   "id": 39,
   "category": "argo",
   "context": "",
   "en": "She's been giving me the cold shoulder all week.",
   "tr": "Bütün hafta bana soğuk davrandı."
  },
  {
   "id": 40,
   "category": "argo",
   "context": "",
   "en": "Get off my back, will you?",
   "tr": "Çekil üstümden, tamam mı?"
  },
  {
   "id": 41,
   "category": "argo",
   "context": "",
   "en": "You're full of it, and you know it.",
   "tr": "Doydun ve biliyorsun."
  },
  {
   "id": 42,
   "category": "argo",
   "context": "",
   "en": "He's all talk and no action.",
   "tr": "Hep konuşur, hiçbir şey yapmaz."
  },
  {
   "id": 43,
   "category": "argo",
   "context": "",
   "en": "Don't try to sweet-talk me.",
   "tr": "Benimle tatlı dille konuşmaya çalışma."
  },
  {
   "id": 48,
   "category": "argo",
   "context": "",
   "en": "She's out of her league and she knows it.",
   "tr": "O artık kendinde değil ve bunu biliyor."
  },
  {
   "id": 50,
   "category": "argo",
   "context": "",
   "en": "You think I was born yesterday?",
   "tr": "Dün doğduğumu mu sanıyorsun?"
  },
  {
   "id": 51,
   "category": "argo",
   "context": "",
   "en": "Man, this place gives me the creeps.",
   "tr": "Abi, burası beni ürpertiyor."
  },
  {
   "id": 52,
   "category": "argo",
   "context": "",
   "en": "He kicked the bucket last winter.",
   "tr": "Geçen kış işi bitirmişti."
  },
  {
